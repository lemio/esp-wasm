 #endif
 
 
-void DefaultIRQHandler( void ) __attribute__((section(VECTOR_HANDLER_SECTION))) __attribute__((naked)) __attribute__((used));
+// esp-wasm: clang (unlike GCC) rejects C statements in naked functions.
+// DefaultIRQHandler never returns, so it needs no naked; the NMI handler returns
+// from an interrupt, so it's an interrupt function (mret) instead.
+#ifdef __clang__
+#define FUN_C_HANDLER_NAKED
+#define FUN_C_HANDLER_RETURNS __attribute__((interrupt))
+#else
+#define FUN_C_HANDLER_NAKED __attribute__((naked))
+#define FUN_C_HANDLER_RETURNS __attribute__((naked))
+#endif
+void DefaultIRQHandler( void ) __attribute__((section(VECTOR_HANDLER_SECTION))) FUN_C_HANDLER_NAKED __attribute__((used));
 // used to clear the CSS flag in case of clock fail switch
 #if defined(FUNCONF_USE_CLK_SEC) && FUNCONF_USE_CLK_SEC
-	void NMI_RCC_CSS_IRQHandler( void ) __attribute__((section(VECTOR_HANDLER_SECTION))) __attribute__((naked)) __attribute__((used));
+	void NMI_RCC_CSS_IRQHandler( void ) __attribute__((section(VECTOR_HANDLER_SECTION))) FUN_C_HANDLER_RETURNS __attribute__((used));
 #endif
 
