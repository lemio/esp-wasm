diff --git a/cores/esp32/esp32-hal-rmt.c b/cores/esp32/esp32-hal-rmt.c
index 184cd0abf..8f67d0c3a 100644
--- a/cores/esp32/esp32-hal-rmt.c
+++ b/cores/esp32/esp32-hal-rmt.c
@@ -104,6 +104,27 @@ static bool _rmt_tx_done_callback(rmt_channel_handle_t channel, const rmt_tx_don
   return high_task_wakeup == pdTRUE;
 }
 
+// esp-wasm: the TX done callback sets RMT_FLAG_TX_DONE with
+// xEventGroupSetBitsFromISR(), which only queues the work for the FreeRTOS
+// timer task. If that queue is full the post is dropped, the bit never gets
+// set, and a blocking rmtWrite() (e.g. Adafruit NeoPixel's show()) waits
+// forever. Ask the RMT driver itself instead, which doesn't depend on the
+// timer task. timeout_ms: 0 = just check, RMT_WAIT_FOR_EVER = no limit.
+static bool _rmtTxDone(rmt_bus_handle_t bus, uint32_t timeout_ms) {
+  if (xEventGroupGetBits(bus->rmt_events) & RMT_FLAG_TX_DONE) {
+    return true;
+  }
+  if (bus->rmt_ch_is_looping) {
+    return false;  // a looping transmission never completes
+  }
+  int wait = timeout_ms == RMT_WAIT_FOR_EVER ? -1 : (int)timeout_ms;
+  if (rmt_tx_wait_all_done(bus->rmt_channel_h, wait) != ESP_OK) {
+    return false;
+  }
+  xEventGroupSetBits(bus->rmt_events, RMT_FLAG_TX_DONE);
+  return true;
+}
+
