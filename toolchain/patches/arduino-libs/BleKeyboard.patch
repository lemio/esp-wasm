+// esp-wasm: arduino-esp32 3.x's BLE library runs on NimBLE here, which adds the
+// 0x2902 (notification) descriptors itself: getDescriptorByUUID() returns null,
+// and dereferencing it crashed on connect. Only touch them on Bluedroid.
+static void setNotifications(BLECharacteristic* c, bool on) {
+#if !defined(USE_NIMBLE) && defined(CONFIG_BLUEDROID_ENABLED)
+  BLE2902* desc = (BLE2902*)c->getDescriptorByUUID(BLEUUID((uint16_t)0x2902));
+  if (desc) desc->setNotifications(on);
+#else
+  (void)c; (void)on;
+#endif
+}
